{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/coscila/coscila-review/instruments/claim-match/1/output.schema.json",
  "title": "claim-match@1 response",
  "description": "One object with exactly one output item per input item. The validator also checks that each quote occurs exactly in the candidate sentence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "match", "reliance", "quote", "rationale", "abstainReason"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "match": {"enum": ["same-claim", "related-claim", "different-claim", "abstain"]},
          "reliance": {"enum": ["cites-review-for-claim", "cites-review-otherwise", "unclear"]},
          "quote": {"type": "string", "maxLength": 600},
          "rationale": {"type": "string", "minLength": 1, "maxLength": 600},
          "abstainReason": {"type": "string", "maxLength": 300}
        }
      }
    }
  }
}
