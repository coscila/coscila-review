{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "confidential": {"type": "boolean", "default": true},
    "allowSanitizedQueries": {"type": "boolean", "default": true},
    "maxQueryTerms": {"type": "integer", "minimum": 1, "maximum": 30},
    "approvedOperations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "approvedFields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "sharedCache": {"type": "boolean", "default": false}
  }
}

