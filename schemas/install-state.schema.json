{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ocsl.local/schemas/review-install-state.schema.json",
  "title": "OC Science Lab review integration state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "installId",
    "installedAt",
    "reviewHome",
    "reviewState",
    "skillManifest",
    "mcp",
    "requirements",
    "staging",
    "siblings"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "installId": { "type": "string", "minLength": 8 },
    "installedAt": { "type": "string", "format": "date-time" },
    "reviewHome": { "type": "string", "minLength": 1 },
    "reviewState": { "type": "string", "minLength": 1 },
    "skillManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configPath",
        "configExisted",
        "configMode",
        "backupPath",
        "backupSha256",
        "previousOwned",
        "installedOwned"
      ],
      "properties": {
        "configPath": { "type": "string", "minLength": 1 },
        "stagedConfigPath": { "type": "string", "minLength": 1 },
        "configExisted": { "type": "boolean" },
        "configMode": { "type": "integer", "minimum": 0, "maximum": 511 },
        "backupPath": { "type": "string", "minLength": 1 },
        "backupSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "previousOwned": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ocsl_review_catalog", "ocsl_scholar"],
          "properties": {
            "ocsl_review_catalog": { "$ref": "#/$defs/previous" },
            "ocsl_scholar": { "$ref": "#/$defs/previous" }
          }
        },
        "installedOwned": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ocsl_review_catalog", "ocsl_scholar"],
          "properties": {
            "ocsl_review_catalog": { "type": "object" },
            "ocsl_scholar": { "type": "object" }
          }
        }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environmentVariables", "readOnlyRoots"],
      "properties": {
        "environmentVariables": {
          "type": "object",
          "additionalProperties": { "type": ["string", "null"] }
        },
        "readOnlyRoots": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "staging": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "cwd"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "cwd": { "type": "string", "minLength": 1 }
      }
    },
    "siblings": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/gitSnapshot" }
    }
  },
  "$defs": {
    "previous": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present", "value"],
      "properties": {
        "present": { "type": "boolean" },
        "value": {}
      }
    },
    "gitSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head", "indexDiffSha256", "worktreeDiffSha256"],
      "properties": {
        "head": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "indexDiffSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "worktreeDiffSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
