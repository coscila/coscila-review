{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "standard"],
  "properties": {
    "schema_version": {"const": 1},
    "standard": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "url", "authority", "purpose", "media_type", "version_policy"],
      "dependentRequired": {
        "archive_url": ["sha256"]
      },
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"}, "title": {"type": "string", "minLength": 3},
        "url": {"type": "string", "pattern": "^https://"}, "authority": {"type": "string", "minLength": 2},
        "purpose": {"type": "string", "minLength": 10}, "media_type": {"enum": ["text/html", "application/pdf"]},
        "version_policy": {"enum": ["current-official-page", "publisher-hosted-edition", "named-version"]},
        "archive_url": {"type": "string", "pattern": "^https://web\\.archive\\.org/web/[0-9]{14}id_/https://"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }}
  }
}
