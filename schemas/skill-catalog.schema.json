{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ocsl.local/schemas/review-skill-catalog.schema.json",
  "title": "OC Science Lab review skill catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill"],
  "properties": {
    "schema_version": { "const": 1 },
    "skill": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "summary",
          "primary_environment",
          "secondary_environments",
          "mcps",
          "outputs",
          "confidential_by_default"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ocsl-review-[a-z0-9-]+$"
          },
          "title": { "type": "string", "minLength": 3 },
          "summary": { "type": "string", "minLength": 20 },
          "primary_environment": {
            "enum": [
              "review-core",
              "review-documents",
              "review-literature",
              "review-nlp",
              "review-statistics",
              "mcp-review"
            ]
          },
          "secondary_environments": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "review-core",
                "review-documents",
                "review-literature",
                "review-nlp",
                "review-statistics",
                "mcp-review"
              ]
            }
          },
          "mcps": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": ["ocsl_review_catalog", "ocsl_scholar"]
            }
          },
          "outputs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 3 }
          },
          "confidential_by_default": { "const": true }
        }
      }
    }
  }
}
