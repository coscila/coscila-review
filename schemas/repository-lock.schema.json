{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "resolvedAt", "repositories"],
  "properties": {
    "schemaVersion": {"const": 1}, "resolvedAt": {"type": "string", "format": "date-time"},
    "repositories": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "url", "commit", "license", "licenseEvidence", "executed"],
      "properties": {
        "id": {"type": "string"}, "url": {"type": "string", "pattern": "^https://"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "license": {"type": "string"},
        "licenseEvidence": {"type": "string", "minLength": 10}, "executed": {"type": "boolean"}
      }
    }}
  }
}

