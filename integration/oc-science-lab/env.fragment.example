# Absolute operator-owned locations
OCSL_REVIEW_HOME='/srv/oc-science-lab-review'
OCSL_REVIEW_STATE='/var/lib/ocsl-review'

# Global skill discovery for both agent runtimes
OCSL_REVIEW_NATIVE_SKILLS_ROOT='/var/lib/ocsl-agent/skills'
OCSL_REVIEW_CODEX_SKILLS_ROOT='/var/lib/codex/skills'

# Deployment MCP source and its real restaging operation
OCSL_REVIEW_MCP_CONFIG='/var/lib/ocsl-agent/.claude.json'
OCSL_REVIEW_STAGE_COMMAND='corepack pnpm puppenclaw:config'
OCSL_REVIEW_STAGE_CWD='/srv/oc-science-lab'
OCSL_REVIEW_STAGE_TIMEOUT='900'

# Existing OC Science Lab conda roots
LAB_CONDA_INSTALL_ROOT='/var/lib/ocsl/conda-bootstrap'
LAB_CONDA_ROOT='/var/lib/ocsl/chat-conda'

# Append these five absolute paths to the existing sandbox read-only roots:
# /srv/oc-science-lab-review
# /var/lib/ocsl-review/environment-templates
# /var/lib/ocsl-review/environment-locks
# /var/lib/ocsl-review/repository-store
# /var/lib/ocsl-review/standards-store
