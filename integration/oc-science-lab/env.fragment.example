# Append to the oc-science-lab deployment environment. The values are examples:
# replace each absolute path with the path on your host.

OCSL_REVIEW_HOME='/srv/oc-science-lab-review'
OCSL_REVIEW_STATE='/srv/science-lab/review-state'

# Global skill discovery for both agent runtimes. These mirror the roots the
# deployment already uses: $CLAUDE_CONFIG_DIR/skills and $CLAUDE_HOME/.claude/skills.
OCSL_REVIEW_NATIVE_SKILLS_ROOT='/srv/science-lab/cache/claude-config/skills'
OCSL_REVIEW_CODEX_SKILLS_ROOT='/srv/science-lab/cache/claude-home/.claude/skills'

# Merge source: the REAL config file, never the symlinked alias. The transaction
# refuses to write through a symbolic link, so where $CLAUDE_HOME/.claude.json
# is a symlink, name its target here.
OCSL_REVIEW_MCP_CONFIG='/srv/science-lab/cache/claude-config/.claude.json'

# Generated output consumed by the agent after staging. This is REQUIRED by
# `integrate install`/`verify` and must be distinct from OCSL_REVIEW_MCP_CONFIG.
OCSL_REVIEW_STAGED_MCP_CONFIG='/srv/science-lab/runtime/agent-bin/codex-mcp.json'

# The deployment's restaging operation.
OCSL_REVIEW_STAGE_COMMAND='corepack pnpm puppenclaw:config'
OCSL_REVIEW_STAGE_CWD='/srv/oc-science-lab'
OCSL_REVIEW_STAGE_TIMEOUT='900'

# Tracked-tree snapshot target for the install-time no-modification check.
OCSL_REPO='/srv/oc-science-lab'

# The laboratory's existing conda roots.
LAB_CONDA_INSTALL_ROOT='/srv/science-lab/conda-install'
LAB_CONDA_ROOT='/srv/science-lab/cache/conda'

# Append these read-only roots to LAB_SANDBOX_RO_ROOTS (semicolon-separated).
# $OCSL_REVIEW_STATE itself must NOT be read-only: manifests, caches, and
# operator build state are written there.
#   /srv/oc-science-lab-review
#   /srv/science-lab/review-state/environment-templates
#   /srv/science-lab/review-state/environment-locks
#   /srv/science-lab/review-state/repository-store
#   /srv/science-lab/review-state/standards-store
