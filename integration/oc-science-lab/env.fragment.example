# Append to the oc-science-lab deployment env (values below are the core6
# deployment; adapt the absolute paths for another host).

OCSL_REVIEW_HOME='/home/phflot/openclaw/oc-science-lab-review'
OCSL_REVIEW_STATE='/local/science_lab_workspace/review-state'

# Global skill discovery for both agent runtimes. These mirror the roots the
# deployment already uses: $CLAUDE_CONFIG_DIR/skills and $CLAUDE_HOME/.claude/skills.
OCSL_REVIEW_NATIVE_SKILLS_ROOT='/local/science_lab_workspace/cache/claude-config/skills'
OCSL_REVIEW_CODEX_SKILLS_ROOT='/local/science_lab_workspace/cache/claude-home/.claude/skills'

# Merge source: the REAL config file, never the symlinked alias. The transaction
# refuses to write through a symbolic link, and
# $CLAUDE_HOME/.claude.json is a symlink to this path on core6.
OCSL_REVIEW_MCP_CONFIG='/local/science_lab_workspace/cache/claude-config/.claude.json'

# Generated output consumed by the agent after staging. This is REQUIRED by
# `integrate install`/`verify` and must be distinct from OCSL_REVIEW_MCP_CONFIG.
OCSL_REVIEW_STAGED_MCP_CONFIG='/local/science_lab_workspace/runtime/agent-bin/codex-mcp.json'

# Real restaging operation for this deployment.
OCSL_REVIEW_STAGE_COMMAND='corepack pnpm puppenclaw:config'
OCSL_REVIEW_STAGE_CWD='/home/phflot/openclaw/oc-science-lab'
OCSL_REVIEW_STAGE_TIMEOUT='900'

# Tracked-tree snapshot target for the install-time no-modification check.
OCSL_REPO='/home/phflot/openclaw/oc-science-lab'

# Existing OC Science Lab conda roots (already set on core6).
LAB_CONDA_INSTALL_ROOT='/local/science_lab_workspace/conda-install'
LAB_CONDA_ROOT='/local/science_lab_workspace/cache/conda'

# Append these read-only roots to LAB_SANDBOX_RO_ROOTS (semicolon-separated).
# $OCSL_REVIEW_STATE itself must NOT be read-only: manifests, caches, and
# operator build state are written there.
#   /home/phflot/openclaw/oc-science-lab-review
#   /local/science_lab_workspace/review-state/environment-templates
#   /local/science_lab_workspace/review-state/environment-locks
#   /local/science_lab_workspace/review-state/repository-store
#   /local/science_lab_workspace/review-state/standards-store
